# Geocoding provider: "google", "nominatim" (free, no key needed), or "mapbox".
GEOCODING_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# PostgreSQL connection string (Neon). Get this from the Neon dashboard ->
# your project -> Connection Details -> "Connection string" (pooled
# connection recommended). Include "?sslmode=require" - Neon requires TLS.
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Leave unset to fall back to a local ./rootplan.db SQLite file (dev only -
# never use SQLite in production/Render, since its file lives on the
# backend's local disk and is lost on every redeploy).
DATABASE_URL=
