# Geocoding provider: "google", "nominatim" (free, no key needed), or "mapbox".
GEOCODING_PROVIDER=google
# Needs "Geocoding API" enabled on this key's Google Cloud project (APIs &
# Services -> Library).
GOOGLE_MAPS_API_KEY=
# Optional - a SEPARATE key restricted to "Places API" only, used solely for
# the named-apartment/building fallback in app/geocoding/google_geocoder.py's
# _find_place (the structured Geocoding API above often can't place a named
# complex like "Sidharth Upscale Apartments" - Places' fuzzy text search
# can). Google Cloud API-restricted keys are commonly scoped to one API each
# (least-privilege), which is why this is a separate setting rather than
# reusing GOOGLE_MAPS_API_KEY. Leave blank to use GOOGLE_MAPS_API_KEY for
# both APIs instead (then make sure THAT key also has Places API enabled/
# allowlisted). Missing entirely just means the fallback never fires -
# nothing else breaks.
GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=

# PostgreSQL connection string (Neon). Get this from the Neon dashboard ->
# your project -> Connection Details -> "Connection string" (pooled
# connection recommended). Include "?sslmode=require" - Neon requires TLS.
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Leave unset to fall back to a local ./rootplan.db SQLite file (dev only -
# never use SQLite in production/Render, since its file lives on the
# backend's local disk and is lost on every redeploy).
DATABASE_URL=
