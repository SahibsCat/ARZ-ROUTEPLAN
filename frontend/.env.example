# Only needed when the frontend and backend are NOT same-origin - e.g. on
# Render, where they're deployed as two separate services with different
# URLs. Set to the backend service's Render URL (no trailing slash) before
# running `npm run build` for production. Leave unset for local dev (the
# Vite proxy in vite.config.js handles it) or a Cloudflare tunnel.
VITE_API_BASE_URL=

# Turns on the live marker map in the Route workspace (right-hand panel).
# This is a Google Maps JavaScript API key, browser-restricted by HTTP
# referrer - a different product from the server-side Geocoding API key in
# backend/.env, and NOT the same value. Google Cloud Console -> APIs &
# Services -> Credentials -> Create Credentials -> API Key, enable "Maps
# JavaScript API" for it, restrict it to your frontend's domain(s). Leave
# unset and the map panel shows a plain "Open in Google Maps" link instead.
VITE_GOOGLE_MAPS_API_KEY=
